{
  "name": "@pattern-js/mod-admin",
  "version": "0.4.0",
  "description": "Pattern admin mod — authorable, self-reflecting control surface (control plane, workflow store, run inspection).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pattern",
    "mod",
    "admin",
    "workflow",
    "control-plane"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "dist-app",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:app",
    "build:backend": "tsc -p tsconfig.json",
    "build:app": "vite build",
    "dev:app": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/app/tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@pattern-js/admin-sdk": "workspace:*",
    "@pattern-js/core": "workspace:*",
    "@pattern-js/runtime-node": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@pattern-js/mod-sample": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.11.6",
    "happy-dom": "^20.14.0",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makkr-studio/pattern.git",
    "directory": "packages/mod-admin"
  },
  "homepage": "https://github.com/makkr-studio/pattern#readme",
  "bugs": "https://github.com/makkr-studio/pattern/issues",
  "author": "Makkr Studio (https://github.com/makkr-studio)"
}
